    {
      "parameters": {
        "jsCode": "// Transforma la respuesta de Nuby a filas planas para el Sheet.\nconst data = $('Traer propiedades de Nuby').first().json;\nconst props = data.properties || [];\nif (!props.length) {\n  throw new Error('Nuby devolvió 0 propiedades — se aborta para no dejar el Sheet vacío');\n}\nconst slug = s => (s || '').toString().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-|-$/g, '');\nconst fmt = n => (n && n > 0) ? n : '';\nconst ahora = new Date().toLocaleString('sv-SE', { timeZone: 'America/Bogota' }).slice(0, 16);\nreturn props.map(p => ({ json: {\n  id: p.Codigo,\n  titulo: (p.Titulo || '').replace(/\\s+/g, ' ').trim(),\n  tipo: p.Tipo || '',\n  servicio: p.Servicio || '',\n  municipio: p.Municipio || '',\n  barrio: (p.Barrio || '').replace(/\\s+/g, ' ').trim(),\n  direccion: (p.Direccion || '').replace(/\\s+/g, ' ').trim(),\n  area_m2: p.Area || '',\n  habitaciones: (p.Caracteristicas_values && p.Caracteristicas_values.no_de_habitaciones) || '',\n  banos: (p.Caracteristicas_values && p.Caracteristicas_values.no_de_banos) || '',\n  canon_arriendo: fmt(p.Arriendo),\n  precio_venta: fmt(p.Venta),\n  administracion: fmt(p.Administracion),\n  caracteristicas: Object.entries(p.Caracteristicas_values || {}).map(([k, v]) => k.replace(/_/g, ' ') + ': ' + v).join(', '),\n  descripcion: (p.Observaciones || '').toString().replace(/<[^>]*>/g, ' ').replace(/\\s+/g, ' ').trim(),\n  link: 'https://inmobiliariatullave.com/detalle-propiedad/?' + slug(p.Tipo) + '-en-' + slug(p.Servicio) + '-' + p.Codigo,\n  imagen: p.Imagen || '',\n  fecha_consignacion: p.fecha_consignacion || '',\n  actualizado: ahora\n}}));"
      },
