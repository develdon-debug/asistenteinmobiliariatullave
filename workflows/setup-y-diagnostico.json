    {
      "parameters": {
        "jsCode": "const filas = $input.all().map(i => i.json);\nconst nuby = $('Traer propiedades de Nuby').first().json.properties || [];\nconst idsNuby = nuby.map(p => p.Codigo).sort((a, b) => a - b);\nconst idsSheet = filas.map(f => Number(f.id)).sort((a, b) => a - b);\nconst coinciden = JSON.stringify(idsNuby) === JSON.stringify(idsSheet);\nreturn [{ json: {\n  ok: coinciden,\n  propiedades_en_nuby: idsNuby.length,\n  filas_en_sheet: idsSheet.length,\n  ids_coinciden: coinciden,\n  ids_nuby: idsNuby,\n  ids_sheet: idsSheet,\n  muestra_primera_fila: filas[0] || null,\n  hora_bogota: new Date().toLocaleString('sv-SE', { timeZone: 'America/Bogota' })\n} }];"
      },
