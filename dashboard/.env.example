# Copia este archivo a .env y completa los valores. NUNCA subas el .env a git.

# Conexión a Postgres.
# - Desarrollo local contra Railway: usa la "Public Network" connection string del
#   servicio Postgres en Railway (pestaña Connect), algo como:
#   postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PUERTO/railway
# - Desplegado en Railway: usa la URL interna (postgres.railway.internal).
DATABASE_URL=postgresql://usuario:password@localhost:5432/tullave

# Pon "true" si la conexión requiere SSL (Railway público lo requiere).
PGSSL=false

# Contraseña que usarán los asesores para entrar al dashboard.
ADVISOR_PASSWORD=cambiame

# Cualquier texto largo aleatorio; firma las cookies de sesión.
SESSION_SECRET=cambia-esto-por-algo-aleatorio-y-largo

PORT=3000
